{
  "name": "coki-app",
  "private": true,
  "version": "0.0.18",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "bump-version": "pnpm version patch --no-git-tag-version",
    "commit-version": "git diff --quiet HEAD -- package.json || (git add package.json && git commit -m \"Auto-commit frontend version\" -- package.json && git push)",
    "build": "pnpm run build:prod",
    "build:prod": "pnpm run bump-version && tsc && vite build --mode prod && pnpm run commit-version",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.0.8",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/x-date-pickers": "^9.0.0",
    "@react-pdf/renderer": "^4.4.0",
    "@reduxjs/toolkit": "^2.5.0",
    "dayjs": "^1.11.20",
    "formik": "2.4.6",
    "pocketbase": "^0.26.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "react-json-view": "^1.21.3",
    "react-number-format": "^5.4.4",
    "react-redux": "^8.0.2",
    "react-router-dom": "^6.17.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@types/node": "20.3.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3"
  }
}
